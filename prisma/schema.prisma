generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scan {
  id        String   @id @default(cuid())
  url       String
  grade     String?
  score     Int?
  results   Json?
  aiSummary String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([url])
  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  plan      String   @default("free")
  scans     Scan[]
  createdAt DateTime @default(now())
}
