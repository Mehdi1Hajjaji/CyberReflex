# Runtime app queries. Use Supabase Supavisor Transaction pooler for Vercel/serverless.
# Format from Supabase Connect > Transaction pooler, usually port 6543.
DATABASE_URL="postgresql://postgres.hrjdwtaccgthqzwrnkqt:<SUPABASE_DB_PASSWORD>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma CLI/migrations. Use the direct DB URL.
DIRECT_URL="<SUPABASE_DIRECT_POSTGRES_URL>"

NEXT_PUBLIC_SUPABASE_URL="https://hrjdwtaccgthqzwrnkqt.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="<SUPABASE_PUBLISHABLE_KEY>"
AUTH_SECRET="<LONG_RANDOM_SECRET>"

NEXTAUTH_URL="https://cyberreflex.com"
AUTH_TRUST_HOST="true"

# OAuth providers are enabled only when both id and secret are present.
GOOGLE_CLIENT_ID="<GOOGLE_OAUTH_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<GOOGLE_OAUTH_CLIENT_SECRET>"
GITHUB_CLIENT_ID="<GITHUB_OAUTH_CLIENT_ID>"
GITHUB_CLIENT_SECRET="<GITHUB_OAUTH_CLIENT_SECRET>"

# Auth.js standard aliases are also supported by src/auth.ts:
# NEXTAUTH_SECRET="<LONG_RANDOM_SECRET>"
# AUTH_GOOGLE_ID="<GOOGLE_OAUTH_CLIENT_ID>"
# AUTH_GOOGLE_SECRET="<GOOGLE_OAUTH_CLIENT_SECRET>"
# AUTH_GITHUB_ID="<GITHUB_OAUTH_CLIENT_ID>"
# AUTH_GITHUB_SECRET="<GITHUB_OAUTH_CLIENT_SECRET>"

# OAuth callback URLs to allow in provider consoles:
# Google:
# http://localhost:3000/api/auth/callback/google
# https://cyber-reflex.vercel.app/api/auth/callback/google
# https://cyberreflex.com/api/auth/callback/google
# GitHub:
# http://localhost:3000/api/auth/callback/github
# https://cyber-reflex.vercel.app/api/auth/callback/github
# https://cyberreflex.com/api/auth/callback/github

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
